@model List<PropertyManagement.Web.Models.Properties.PropertyListItemViewModel>
@{
    ViewData["Title"] = "My Properties";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>My Properties</h1>
    <div>
        <a class="btn btn-outline-secondary btn-sm" asp-action="Index" asp-route-showRemoved="@(!(bool)ViewBag.ShowRemoved)">
            @(((bool)ViewBag.ShowRemoved) ? "Hide" : "Show") removed
        </a>
        <button type="button" class="btn btn-primary" data-modal-trigger data-modal-url="@Url.Action("Create")" data-modal-refresh="#propertiesList">
            Add Property
        </button>
    </div>
</div>

<partial name="_PropertiesList" model="Model" />
