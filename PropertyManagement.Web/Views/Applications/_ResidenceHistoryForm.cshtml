@model PropertyManagement.Web.Models.Applications.ResidenceHistoryFormViewModel

<div class="modal-header">
    <h5 class="modal-title">@(Model.EntryId is null ? "Add Residence" : "Edit Residence")</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<form asp-action="ResidenceHistorySave" asp-route-id="@Model.ApplicationId" method="post">
    <div class="modal-body">
        @if (Model.Errors.Count > 0)
        {
            <div class="alert alert-danger">
                <ul class="mb-0">
                    @foreach (var error in Model.Errors)
                    {
                        <li>@error.Message</li>
                    }
                </ul>
            </div>
        }
        <input type="hidden" asp-for="ApplicationId" />
        <input type="hidden" asp-for="EntryId" />
        <input type="hidden" asp-for="Version" />
        <div class="mb-3">
            <label class="form-label">Address</label>
            <input asp-for="AddressLine1" class="form-control" />
        </div>
        <div class="row">
            <div class="col mb-3">
                <label class="form-label">City</label>
                <input asp-for="City" class="form-control" />
            </div>
            <div class="col mb-3">
                <label class="form-label">State</label>
                <input asp-for="State" class="form-control" />
            </div>
            <div class="col mb-3">
                <label class="form-label">Zip</label>
                <input asp-for="ZipCode" class="form-control" />
            </div>
        </div>
        <div class="row">
            <div class="col mb-3">
                <label class="form-label">Landlord name</label>
                <input asp-for="LandlordName" class="form-control" />
            </div>
            <div class="col mb-3">
                <label class="form-label">Landlord phone</label>
                <input asp-for="LandlordPhone" class="form-control" />
            </div>
        </div>
        <div class="row">
            <div class="col mb-3">
                <label class="form-label">Move-in date</label>
                <input asp-for="MoveInDate" type="date" class="form-control" />
            </div>
            <div class="col mb-3">
                <label class="form-label">Move-out date (leave blank if current)</label>
                <input asp-for="MoveOutDate" type="date" class="form-control" />
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>
