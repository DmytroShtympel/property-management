@model PropertyManagement.Web.Models.Applications.ApplicationDetailsViewModel

<h5>Manager Notes</h5>
<p class="text-muted small">Visible only to property managers.</p>

<form asp-controller="ApplicationReview" asp-action="AddNote" asp-route-id="@Model.Id" method="post" class="mb-3">
    <div class="input-group">
        <input type="text" name="body" class="form-control" placeholder="Add a note..." required />
        <button type="submit" class="btn btn-outline-secondary">Add</button>
    </div>
</form>

@if (Model.Notes.Count == 0)
{
    <p class="text-muted">No notes yet.</p>
}
else
{
    <ul class="list-group">
        @foreach (var note in Model.Notes)
        {
            <li class="list-group-item">
                <div>@note.Body</div>
                <div class="text-muted small">@note.AuthorName &mdash; @note.CreatedAtUtc.ToLocalTime().ToString("g")</div>
            </li>
        }
    </ul>
}
