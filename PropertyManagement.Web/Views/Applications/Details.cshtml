@using PropertyManagement.Domain.Enums
@model PropertyManagement.Web.Models.Applications.ApplicationDetailsViewModel
@{
    ViewData["Title"] = "Application - " + Model.UnitLabel;
}

<p><a asp-action="Index">&laquo; Back to Applications</a></p>

<div class="d-flex justify-content-between align-items-start">
    <div>
        <h1>@Model.UnitLabel</h1>
        <p class="text-muted">Applicant(s): @string.Join(", ", Model.ApplicantNames)</p>
    </div>
    <vc:application-status-badge status="Model.Status" />
</div>

@if (TempData["ReviewError"] is string reviewError)
{
    <div class="alert alert-danger">@reviewError</div>
}

<div class="row">
    <div class="col-md-8">
        <h5>Applicant Information</h5>
        <dl class="row">
            <dt class="col-sm-3">Full legal name</dt>
            <dd class="col-sm-9">@Model.ApplicantInformation.FullLegalName</dd>
            <dt class="col-sm-3">Phone</dt>
            <dd class="col-sm-9">@Model.ApplicantInformation.PhoneNumber</dd>
            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.ApplicantInformation.Email</dd>
            <dt class="col-sm-3">Current address</dt>
            <dd class="col-sm-9">@Model.ApplicantInformation.CurrentAddress</dd>
        </dl>

        <h5>Residence History</h5>
        <vc:residence-history-summary entries="Model.ResidenceHistoryEntries" />

        @if (Model.Lease is not null)
        {
            <h5>Lease</h5>
            <dl class="row">
                <dt class="col-sm-3">Term</dt>
                <dd class="col-sm-9">@Model.Lease.StartDate.ToString("d") &ndash; @Model.Lease.EndDate.ToString("d")</dd>
                <dt class="col-sm-3">Monthly rent</dt>
                <dd class="col-sm-9">@Model.Lease.MonthlyRent.ToString("C")</dd>
            </dl>
        }

        <h5>History</h5>
        <vc:application-status-history items="Model.StatusHistory" />

        <div class="mt-3">
            @if (Model.CanEdit)
            {
                <a asp-action="Wizard" asp-route-id="@Model.Id" class="btn btn-primary">Continue Editing</a>
            }
            @if (Model.CanWithdraw)
            {
                <form asp-action="Withdraw" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Withdraw this application?');">
                    <button type="submit" class="btn btn-outline-danger">Withdraw</button>
                </form>
            }
        </div>
    </div>

    @if (Model.IsManagerView)
    {
        <div class="col-md-4">
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title">Review</h5>
                    @if (Model.ClaimedByName is null)
                    {
                        <p class="text-muted">Unclaimed.</p>
                        @if (Model.Status == ApplicationStatus.Submitted)
                        {
                            <form asp-controller="ApplicationReview" asp-action="Claim" asp-route-id="@Model.Id" method="post">
                                <button type="submit" class="btn btn-outline-primary btn-sm">Claim</button>
                            </form>
                        }
                    }
                    else
                    {
                        <p>Claimed by <strong>@Model.ClaimedByName</strong>@(Model.ClaimedByCurrentUser ? " (you)" : "")</p>
                        @if (Model.ClaimedByCurrentUser)
                        {
                            <form asp-controller="ApplicationReview" asp-action="Release" asp-route-id="@Model.Id" method="post" class="mb-2">
                                <button type="submit" class="btn btn-outline-secondary btn-sm">Release</button>
                            </form>
                            <partial name="_ReviewModal" model="Model" />
                        }
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <partial name="_ApplicationNotesPanel" model="Model" />
                </div>
            </div>
        </div>
    }
</div>
