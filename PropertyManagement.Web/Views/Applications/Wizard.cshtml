@using PropertyManagement.Domain.Enums
@model PropertyManagement.Web.Models.Applications.ApplicationWizardViewModel
@{
    ViewData["Title"] = "Application - " + Model.UnitLabel;
}

<h1>@Model.UnitLabel</h1>
<p class="text-muted">Applicant(s): @string.Join(", ", Model.ApplicantNames) &middot; @await Component.InvokeAsync("ApplicationStatusBadge", new { status = Model.Status })</p>

@if (!string.IsNullOrEmpty(Model.StaleSectionMessage))
{
    <div class="alert alert-warning">@Model.StaleSectionMessage</div>
}
@if (Model.Status == ApplicationStatus.Returned && !string.IsNullOrEmpty(Model.LatestReturnComment))
{
    <div class="alert alert-info"><strong>Returned by manager:</strong> @Model.LatestReturnComment</div>
}

<ul class="nav nav-pills mb-3">
    <li class="nav-item"><span class="nav-link @(Model.CurrentStep == ApplicationStep.ApplicantInformation ? "active" : "")">1. Applicant Information</span></li>
    <li class="nav-item"><span class="nav-link @(Model.CurrentStep == ApplicationStep.ResidenceHistory ? "active" : "")">2. Residence History</span></li>
    <li class="nav-item"><span class="nav-link @(Model.CurrentStep == ApplicationStep.Summary ? "active" : "")">3. Summary</span></li>
</ul>

<form asp-action="Wizard" asp-route-id="@Model.Id" method="post">
    @switch (Model.CurrentStep)
    {
        case ApplicationStep.ApplicantInformation:
            <partial name="_ApplicantInformationStep" model="Model" />
            break;
        case ApplicationStep.ResidenceHistory:
            <partial name="_ResidenceHistoryStep" model="Model" />
            break;
        case ApplicationStep.Summary:
            <partial name="_SummaryStep" model="Model" />
            break;
    }

    <div class="mt-3">
        @if (Model.CurrentStep > ApplicationStep.ApplicantInformation)
        {
            <button type="submit" name="Action" value="back" class="btn btn-outline-secondary">Back</button>
        }
        @if (Model.CurrentStep < ApplicationStep.Summary)
        {
            <button type="submit" name="Action" value="continue" class="btn btn-primary">Continue</button>
        }
        else
        {
            <button type="submit" name="Action" value="submit" class="btn btn-success" disabled="@(Model.BlockingErrors.Count > 0)">Submit Application</button>
        }
    </div>
</form>

@if (Model.CurrentStep == ApplicationStep.ApplicantInformation)
{
    <form asp-action="AddCoApplicant" asp-route-id="@Model.Id" method="post" id="addCoApplicantForm"></form>
}

<p class="mt-3"><a asp-action="Details" asp-route-id="@Model.Id">View full details</a></p>
