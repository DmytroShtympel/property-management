@using PropertyManagement.Domain.Enums
@model PropertyManagement.Web.Models.Applications.ApplicationWizardViewModel

<h4>Summary</h4>

@if (Model.BlockingErrors.Count > 0)
{
    <div class="alert alert-danger">
        <strong>The following must be fixed before this application can be submitted:</strong>
        <ul class="mb-0">
            @foreach (var group in Model.BlockingErrors.GroupBy(e => e.Section))
            {
                <li>
                    @group.Key
                    <button type="submit" name="Action" value="@(group.Key == "Residence History" ? "goto-residencehistory" : "goto-applicantinformation")"
                            class="btn btn-link btn-sm p-0 ms-2 align-baseline">Fix this section</button>
                    <ul>
                        @foreach (var error in group)
                        {
                            <li>@error.Message</li>
                        }
                    </ul>
                </li>
            }
        </ul>
    </div>
}
else
{
    <div class="alert alert-success">Everything looks complete. You're ready to submit.</div>
}

<h5>Applicant Information</h5>
<partial name="_ApplicantInformationSection" model="Model" />

<h5>Residence History</h5>
@await Component.InvokeAsync("ResidenceHistory", new { applicationId = Model.Id, entries = Model.ResidenceHistoryEntries, isReadOnly = Model.IsSectionReadOnly(ApplicationStep.ResidenceHistory) })
