@using PropertyManagement.Domain.Enums
@model PropertyManagement.Web.Models.Applications.ApplicationWizardViewModel

<h4>Applicant Information</h4>

@if (Model.CurrentSectionErrors.Count > 0)
{
    <div class="alert alert-warning">
        <strong>This section has not been fully completed yet:</strong>
        <ul class="mb-0">
            @foreach (var error in Model.CurrentSectionErrors)
            {
                <li>@error.Message</li>
            }
        </ul>
    </div>
}

<partial name="_ApplicantInformationSection" model="Model" />

@if (!Model.IsSectionReadOnly(ApplicationStep.ApplicantInformation))
{
    <hr />
    <h5>Co-applicants</h5>
    <p>@string.Join(", ", Model.ApplicantNames)</p>
    <div class="input-group mb-3" style="max-width: 420px;">
        <input type="email" form="addCoApplicantForm" name="email" class="form-control" placeholder="Co-applicant's email" />
        <button type="submit" form="addCoApplicantForm" class="btn btn-outline-secondary">Add co-applicant</button>
    </div>
}
