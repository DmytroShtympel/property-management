@model PropertyManagement.Web.Models.Applications.ApplicationWizardViewModel

<div id="residenceHistoryList">
    @if (Model.ResidenceHistoryEntries.Count == 0)
    {
        <p class="text-muted">No residence history entries yet.</p>
    }
    else
    {
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Address</th>
                    <th>Landlord</th>
                    <th>Move-in</th>
                    <th>Move-out</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in Model.ResidenceHistoryEntries)
                {
                    <tr>
                        <td>@entry.AddressLine1, @entry.City, @entry.State @entry.ZipCode</td>
                        <td>@entry.LandlordName (@entry.LandlordPhone)</td>
                        <td>@entry.MoveInDate.ToString("d")</td>
                        <td>@(entry.MoveOutDate?.ToString("d") ?? "Present")</td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    data-modal-trigger
                                    data-modal-url="@Url.Action("ResidenceHistoryForm", new { id = Model.Id, entryId = entry.Id })"
                                    data-modal-refresh="#residenceHistoryList">
                                Edit
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger"
                                    data-post-trigger
                                    data-confirm="Remove this residence history entry?"
                                    data-post-url="@Url.Action("ResidenceHistoryDelete", new { id = Model.Id, entryId = entry.Id })"
                                    data-post-refresh="#residenceHistoryList">
                                Remove
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
