@model PropertyManagement.Web.Models.Applications.ApplicationDetailsViewModel

<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#reviewModal">Review Application</button>

<div class="modal fade" id="reviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="ApplicationReview" asp-action="Decide" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Review Application</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="Id" value="@Model.Id" />
                    <input type="hidden" name="Outcome" id="reviewOutcome" value="" />
                    <div class="mb-3">
                        <label class="form-label">Comment (required for Return or Deny)</label>
                        <textarea name="Comment" class="form-control" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success" onclick="document.getElementById('reviewOutcome').value='Approve'">Approve</button>
                    <button type="submit" class="btn btn-warning" onclick="document.getElementById('reviewOutcome').value='Return'">Return</button>
                    <button type="submit" class="btn btn-danger" onclick="document.getElementById('reviewOutcome').value='Deny'">Deny</button>
                </div>
            </form>
        </div>
    </div>
</div>
