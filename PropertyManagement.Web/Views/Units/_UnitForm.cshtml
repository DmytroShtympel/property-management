@model PropertyManagement.Web.Models.Units.UnitFormViewModel

<div class="modal-header">
    <h5 class="modal-title">@(Model.Id == 0 ? "Add Unit" : "Edit Unit")</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" asp-route-id="@Model.Id" method="post">
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="PropertyId" />
        <div class="mb-3">
            <label asp-for="UnitNumber" class="form-label"></label>
            <input asp-for="UnitNumber" class="form-control" />
            <span asp-validation-for="UnitNumber" class="text-danger"></span>
        </div>
        <div class="row">
            <div class="col mb-3">
                <label asp-for="Bedrooms" class="form-label"></label>
                <input asp-for="Bedrooms" class="form-control" type="number" />
                <span asp-validation-for="Bedrooms" class="text-danger"></span>
            </div>
            <div class="col mb-3">
                <label asp-for="RentAmount" class="form-label"></label>
                <input asp-for="RentAmount" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="RentAmount" class="text-danger"></span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="UnitTypeId" class="form-label"></label>
            <select asp-for="UnitTypeId" asp-items="Model.UnitTypeOptions" class="form-select">
                <option value="">-- Select a unit type --</option>
            </select>
            <span asp-validation-for="UnitTypeId" class="text-danger"></span>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>
