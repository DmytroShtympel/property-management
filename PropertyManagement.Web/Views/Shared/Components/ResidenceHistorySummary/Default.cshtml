@model List<PropertyManagement.Web.Models.Applications.ResidenceHistoryEntryViewModel>

@if (Model.Count == 0)
{
    <p class="text-muted">No residence history entries yet.</p>
}
else
{
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Address</th>
                <th>Landlord</th>
                <th>Move-in</th>
                <th>Move-out</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in Model)
            {
                <tr>
                    <td>@entry.AddressLine1, @entry.City, @entry.State @entry.ZipCode</td>
                    <td>@entry.LandlordName (@entry.LandlordPhone)</td>
                    <td>@entry.MoveInDate.ToString("d")</td>
                    <td>@(entry.MoveOutDate?.ToString("d") ?? "Present")</td>
                </tr>
            }
        </tbody>
    </table>
}
