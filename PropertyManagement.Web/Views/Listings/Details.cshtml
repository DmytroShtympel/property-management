@using Microsoft.AspNetCore.Identity
@using PropertyManagement.Domain.Entities
@inject SignInManager<ApplicationUser> SignInManager
@model PropertyManagement.Web.Models.Listings.UnitBrowseListItemViewModel
@{
    ViewData["Title"] = $"{Model.PropertyName} - Unit {Model.UnitNumber}";
}

<p><a asp-action="Index">&laquo; Back to listings</a></p>

<h1>@Model.PropertyName &mdash; Unit @Model.UnitNumber</h1>
<p class="text-muted">@Model.City, @Model.State</p>

<dl class="row">
    <dt class="col-sm-3">Unit type</dt>
    <dd class="col-sm-9">@Model.UnitTypeName</dd>
    <dt class="col-sm-3">Bedrooms</dt>
    <dd class="col-sm-9">@Model.Bedrooms</dd>
    <dt class="col-sm-3">Monthly rent</dt>
    <dd class="col-sm-9">@Model.RentAmount.ToString("C")</dd>
</dl>

@if (SignInManager.IsSignedIn(User) && User.IsInRole(Roles.Applicant))
{
    <form asp-action="Apply" asp-route-unitId="@Model.Id" method="post">
        <button type="submit" class="btn btn-primary">Start Application</button>
    </form>
}
else if (!SignInManager.IsSignedIn(User))
{
    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Details", new { id = Model.Id })" class="btn btn-primary">
        Log in as an applicant to apply
    </a>
}
