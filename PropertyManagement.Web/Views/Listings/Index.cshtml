@model List<PropertyManagement.Web.Models.Listings.UnitBrowseListItemViewModel>
@{
    ViewData["Title"] = "Browse Units";
}

<h1>Available Units</h1>

@if (Model.Count == 0)
{
    <p class="text-muted">No units are currently available.</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-3">
        @foreach (var unit in Model)
        {
            <div class="col">
                <partial name="_UnitCard" model="unit" />
            </div>
        }
    </div>
}
